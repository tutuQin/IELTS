    async function playAudio(src, title) {
        currentSrc = src;
        nowPlayingText.innerHTML = `<span>▶ 正在播放：</span> <strong>${title}</strong>`;

        // Highlight active card
        document.querySelectorAll('.slice-card').forEach(card => {
            card.classList.remove('playing');
        });
        const activeBtn = event ? event.target.closest('.slice-card') : null;
        if (activeBtn) {
            activeBtn.classList.add('playing');
        }

        // 关键修复：预览服务器不支持 HTTP Range 请求，直接用相对路径时浏览器无法 seek。
        // 把整段音频下载成 Blob 再用对象 URL 播放，进度条点击/拖动跳转即可百分百生效。
        try {
            if (!audioBlobCache[src]) {
                const resp = await fetch(src);
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                audioBlobCache[src] = URL.createObjectURL(await resp.blob());
            }
            mainAudio.src = audioBlobCache[src];
        } catch (e) {
            // 降级：本地 file:// 打开等场景 fetch 受限时，退回相对路径直接播放
            mainAudio.src = src;
        }
        mainAudio.play().catch(e => console.log('Audio autoplay prevented or stopped:', e));
    }

    function setSpeed(speed, btn) {
        mainAudio.playbackRate = speed;
        document.querySelectorAll('.player-controls .btn-group .pill-btn').forEach(b => {
            b.classList.remove('active');
        });
        btn.classList.add('active');
    }

    function toggleLoop(btn) {
        isLooping = !isLooping;
        mainAudio.loop = isLooping;
        if (isLooping) {
            btn.classList.add('active');
            btn.innerText = '🔁 单曲循环: 开';
        } else {
            btn.classList.remove('active');
            btn.innerText = '🔁 单曲循环: 关';
        }
    }

    function filterCategory(cat, btn) {
        document.querySelectorAll('.filter-tabs .tab-btn').forEach(b => {
            b.classList.remove('active');
        });
        btn.classList.add('active');

        const cards = document.querySelectorAll('.slice-card');
        cards.forEach(card => {
            const cats = (card.dataset.category || '').split(/\s+/);
            if (cat === 'all' || cats.includes(cat)) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
    }

    /* ========================================================
       SHADOWING RECORDING SYSTEM (Web Audio MediaRecorder)
       ======================================================== */
    const userRecordings = {};
    let activeMediaRecorder = null;
    let activeAudioChunks = [];
    let recordingCardId = null;
    let recordTimerInterval = null;
    let recordSeconds = 0;
    let userAudioPlayer = null;

    function handleRecBtnClick(cardId) {
        if (recordingCardId === cardId) {
            stopRecording(cardId);
        } else if (recordingCardId !== null) {
            stopRecording(recordingCardId);
            setTimeout(() => toggleRecording(cardId), 300);
        } else {
            toggleRecording(cardId);
        }
    }

    async function toggleRecording(cardId) {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            alert('抱歉，您的浏览器不支持或未开启录音权限！请使用最新版 Chrome/Edge/Safari 浏览器。');
            return;
        }

        try {
            const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            activeAudioChunks = [];
            recordingCardId = cardId;
            recordSeconds = 0;

            let mimeType = 'audio/webm';
            if (!MediaRecorder.isTypeSupported('audio/webm')) {
                if (MediaRecorder.isTypeSupported('audio/mp4')) {
                    mimeType = 'audio/mp4';
                } else if (MediaRecorder.isTypeSupported('audio/aac')) {
                    mimeType = 'audio/aac';
                } else {
                    mimeType = '';
                }
            }
            
            const options = mimeType ? { mimeType } : {};
            activeMediaRecorder = new MediaRecorder(stream, options);

            activeMediaRecorder.ondataavailable = e => {
                if (e.data && e.data.size > 0) {
                    activeAudioChunks.push(e.data);
                }
            };

            activeMediaRecorder.onstop = () => {
                const blob = new Blob(activeAudioChunks, { type: activeMediaRecorder.mimeType || 'audio/webm' });
                const audioUrl = URL.createObjectURL(blob);
                userRecordings[cardId] = {
                    blob: blob,
                    url: audioUrl,
                    duration: recordSeconds
                };
                
                stream.getTracks().forEach(track => track.stop());
                updateUIAfterRecording(cardId);
            };

            activeMediaRecorder.start(200);

            // Update UI
            const recBtn = document.getElementById(`rec-btn-${cardId}`);
            recBtn.classList.add('recording');
            recBtn.innerHTML = '⏹️ 完成录音';

            const panel = document.getElementById(`user-rec-panel-${cardId}`);
            panel.style.display = 'flex';
            
            const statusText = document.getElementById(`rec-status-${cardId}`);
            statusText.innerText = '🔴 正在录音... 请跟读';
            statusText.style.color = '#f87171';

            const dot = document.getElementById(`rec-dot-${cardId}`);
            dot.classList.add('recording');

            panel.querySelector('.rec-panel-btns').style.display = 'none';

            // Timer
            const timerBadge = document.getElementById(`rec-time-${cardId}`);
            timerBadge.innerText = '00:00';
            clearInterval(recordTimerInterval);
            recordTimerInterval = setInterval(() => {
                recordSeconds++;
                const mins = String(Math.floor(recordSeconds / 60)).padStart(2, '0');
                const secs = String(recordSeconds % 60).padStart(2, '0');
                timerBadge.innerText = `${mins}:${secs}`;
            }, 1000);

        } catch (err) {
            console.error('Microphone access denied or error:', err);
            alert('无法启动录音：请检查浏览器是否已授权麦克风权限！');
        }
    }

    function stopRecording(cardId) {
        if (activeMediaRecorder && activeMediaRecorder.state !== 'inactive') {
            activeMediaRecorder.stop();
        }
        clearInterval(recordTimerInterval);
        recordingCardId = null;

        const recBtn = document.getElementById(`rec-btn-${cardId}`);
        recBtn.classList.remove('recording');
        recBtn.innerHTML = '🎙️ 重新录音';

        const dot = document.getElementById(`rec-dot-${cardId}`);
        dot.classList.remove('recording');
    }

    function updateUIAfterRecording(cardId) {
        const panel = document.getElementById(`user-rec-panel-${cardId}`);
        panel.style.display = 'flex';

        const statusText = document.getElementById(`rec-status-${cardId}`);
        statusText.innerText = '✅ 跟读已录制完成';
        statusText.style.color = '#34d399';

        const btnGroup = panel.querySelector('.rec-panel-btns');
        btnGroup.style.display = 'flex';
    }

    function playUserRecording(cardId) {
        const item = userRecordings[cardId];
        if (!item || !item.url) return;

        if (mainAudio && !mainAudio.paused) {
            mainAudio.pause();
        }

        if (userAudioPlayer) {
            userAudioPlayer.pause();
        }

        userAudioPlayer = new Audio(item.url);
        const playBtn = document.getElementById(`play-user-btn-${cardId}`);
        playBtn.innerText = '⏸️ 正在试听';

        userAudioPlayer.play().catch(e => console.error('Play error:', e));

        userAudioPlayer.onended = () => {
            playBtn.innerText = '▶ 试听跟读';
        };
        userAudioPlayer.onpause = () => {
            playBtn.innerText = '▶ 试听跟读';
        };
    }

    function compareOfficial(cardId) {
        if (userAudioPlayer) {
            userAudioPlayer.pause();
        }
        const card = document.getElementById(`rec-btn-${cardId}`).closest('.slice-card');
        const playBtn = card.querySelector('.play-card-btn');
        playBtn.click();
    }

    function deleteRecording(cardId) {
        if (userRecordings[cardId] && userRecordings[cardId].url) {
            URL.revokeObjectURL(userRecordings[cardId].url);
            delete userRecordings[cardId];
        }
        if (userAudioPlayer) {
            userAudioPlayer.pause();
        }
        const panel = document.getElementById(`user-rec-panel-${cardId}`);
        panel.style.display = 'none';

        const recBtn = document.getElementById(`rec-btn-${cardId}`);
        recBtn.classList.remove('recording');
        recBtn.innerHTML = '🎙️ 录音跟读';
    }
    /* ========================================================
       手动进度条 / 指定起点播放 / AB循环
       ======================================================== */
    const seekSlider = document.getElementById('seek-slider');
    const curTimeLabel = document.getElementById('cur-time-label');
    const durTimeLabel = document.getElementById('dur-time-label');
    let isDraggingSlider = false;

    function fmtTime(t) {
        if (!isFinite(t) || t < 0) t = 0;
        const mins = String(Math.floor(t / 60)).padStart(2, '0');
        const secs = String(Math.floor(t % 60)).padStart(2, '0');
        return `${mins}:${secs}`;
    }

    function parseTimeVal(s) {
        s = (s || '').trim();
        if (!s) return null;
        if (s.includes(':')) {
            const parts = s.split(':').map(Number);
            if (parts.some(isNaN)) return null;
            return parts.reduce((acc, v) => acc * 60 + v, 0);
        }
        const v = parseFloat(s);
        return isNaN(v) ? null : v;
    }

    mainAudio.addEventListener('loadedmetadata', () => {
        if (isFinite(mainAudio.duration)) {
            seekSlider.max = mainAudio.duration;
            durTimeLabel.innerText = fmtTime(mainAudio.duration);
        }
    });

    mainAudio.addEventListener('timeupdate', () => {
        if (!isDraggingSlider) {
            seekSlider.value = mainAudio.currentTime;
        }
        curTimeLabel.innerText = fmtTime(mainAudio.currentTime);
        // AB 循环：播到终点自动跳回起点
        if (abLoopOn && abEndVal !== null && mainAudio.currentTime >= abEndVal) {
            mainAudio.currentTime = abStartVal || 0;
        }
    });

    seekSlider.addEventListener('input', () => {
        isDraggingSlider = true;
        const t = parseFloat(seekSlider.value);
        curTimeLabel.innerText = fmtTime(t);
        // 点击/拖动即刻定位（Blob 音频源支持任意位置 seek）
        if (mainAudio.src && isFinite(mainAudio.duration)) {
            mainAudio.currentTime = t;
        }
    });
    seekSlider.addEventListener('change', () => {
        isDraggingSlider = false;
    });

    /* 快退快进（与 C17T1 点播台同款写法） */
    function skipAudio(seconds) {
        if (!mainAudio.src) return;
        mainAudio.currentTime = Math.max(0, Math.min((mainAudio.currentTime || 0) + seconds, mainAudio.duration || 0));
    }

    function playFromCustomStart() {
        const v = parseTimeVal(document.getElementById('start-at-input').value);
        if (v === null) {
            alert('请输入起点时间：支持秒数（如 90）或 分:秒（如 1:30）');
            return;
        }
        if (!mainAudio.src) {
            alert('请先点击上方任意切片的「▶ 播放切片」加载音频，再指定起点。');
            return;
        }
        mainAudio.currentTime = Math.min(v, mainAudio.duration || v);
        mainAudio.play().catch(e => console.log('Play error:', e));
        nowPlayingText.innerHTML = `<span>▶ 指定起点播放：</span> <strong>${fmtTime(v)} 处</strong>`;
    }

    let abLoopOn = false, abStartVal = null, abEndVal = null;
    function toggleAbLoop(btn) {
        if (!abLoopOn) {
            const a = parseTimeVal(document.getElementById('ab-start').value);
            const b = parseTimeVal(document.getElementById('ab-end').value);
            if (a === null || b === null || b <= a) {
                alert('请填写有效的起点和终点时间（终点必须大于起点），支持秒数或 分:秒。');
                return;
            }
            abStartVal = a;
            abEndVal = b;
            abLoopOn = true;
            btn.classList.add('active');
            btn.innerText = 'AB循环: 开';
            mainAudio.currentTime = a;
            mainAudio.play().catch(e => console.log('Play error:', e));
        } else {
            abLoopOn = false;
            btn.classList.remove('active');
            btn.innerText = 'AB循环: 关';
        }
    }

    function setAbStartFromCurrent() {
        document.getElementById('ab-start').value = fmtTime(mainAudio.currentTime || 0);
    }
</script>

