    <title>剑桥雅思 17 Test 3 Part 1 + Part 4 听力答案句切片点播台</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.7);
            --border-color: rgba(255, 255, 255, 0.1);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent-blue: #38bdf8;
            --accent-green: #34d399;
            --accent-red: #f87171;
            --accent-amber: #fbbf24;
            --accent-purple: #c084fc;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            padding: 30px 20px;
            background-image: radial-gradient(at 0% 0%, rgba(56, 189, 248, 0.15) 0px, transparent 50%),
                              radial-gradient(at 100% 100%, rgba(192, 132, 252, 0.15) 0px, transparent 50%);
            min-height: 100vh;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            margin-bottom: 30px;
        }

        .nav-back-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding: 10px 16px;
            background: rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }

        .nav-link {
            color: var(--accent-blue);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: opacity 0.2s;
        }

        .nav-link:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        header h1 {
            font-size: 2.2rem;
            font-weight: 800;
            background: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }

        header p {
            color: var(--text-muted);
            font-size: 1rem;
        }

        /* Player Sticky Bar */
        .sticky-player {
            position: sticky;
            top: 15px;
            z-index: 100;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 16px 24px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .player-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .now-playing-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--accent-blue);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .player-controls {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            font-size: 0.95rem;
        }

        audio {
            width: 100%;
            height: 42px;
            border-radius: 8px;
            outline: none;
        }

        .btn-group {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .pill-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 7px 16px;
            border-radius: 20px;
            font-size: 0.92rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .pill-btn:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: var(--accent-blue);
        }

        .pill-btn.active {
            background: var(--accent-blue);
            color: #0f172a;
            font-weight: bold;
            border-color: var(--accent-blue);
        }

        /* Filter Tabs */
        .filter-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 25px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .tab-btn {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            padding: 11px 20px;
            border-radius: 12px;
            font-size: 1.05rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .tab-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-main);
        }

        .tab-btn.active {
            background: rgba(56, 189, 248, 0.2);
            color: var(--accent-blue);
            border-color: var(--accent-blue);
        }

        /* Slice Card */
        .slice-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .slice-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 20px 24px;
            transition: transform 0.2s, border-color 0.2s;
            position: relative;
            backdrop-filter: blur(10px);
        }

        .slice-card:hover {
            border-color: rgba(56, 189, 248, 0.4);
            transform: translateY(-2px);
        }

        .slice-card.playing {
            border-color: var(--accent-blue);
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.2);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
        }

        .card-tag {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .tag-p1 { background: rgba(56, 189, 248, 0.2); color: var(--accent-blue); }
        .tag-p2 { background: rgba(52, 211, 153, 0.2); color: var(--accent-green); }
        .tag-p3 { background: rgba(251, 191, 36, 0.2); color: var(--accent-amber); }
        .tag-p4 { background: rgba(248, 113, 113, 0.2); color: var(--accent-red); }
        .tag-full { background: rgba(192, 132, 252, 0.2); color: var(--accent-purple); }

        .card-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.4;
        }

        .card-actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .play-card-btn {
            background: linear-gradient(135deg, #0284c7, #38bdf8);
            border: none;
            color: #ffffff;
            padding: 9px 20px;
            border-radius: 20px;
            font-size: 0.96rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: 0 4px 12px rgba(56, 189, 248, 0.3);
        }

        .play-card-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 16px rgba(56, 189, 248, 0.4);
        }

        .record-card-btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 9px 18px;
            border-radius: 20px;
            font-size: 0.92rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .record-card-btn:hover {
            background: rgba(248, 113, 113, 0.2);
            border-color: var(--accent-red);
            color: #fca5a5;
        }

        .record-card-btn.recording {
            background: var(--accent-red);
            color: #fff;
            animation: pulse-red 1.5s infinite;
            border-color: var(--accent-red);
        }

        @keyframes pulse-red {
            0% { box-shadow: 0 0 0 0 rgba(248, 113, 113, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(248, 113, 113, 0); }
            100% { box-shadow: 0 0 0 0 rgba(248, 113, 113, 0); }
        }

        /* User Shadowing Recording Panel */
        .user-rec-panel {
            background: rgba(15, 23, 42, 0.8);
            border: 1px dashed rgba(248, 113, 113, 0.4);
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        .rec-panel-info {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.9rem;
        }

        .rec-status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--accent-red);
            display: inline-block;
        }

        .rec-status-dot.recording {
            animation: pulse-red 1s infinite;
        }

        .rec-timer-badge {
            font-family: monospace;
            background: rgba(0, 0, 0, 0.4);
            padding: 2px 8px;
            border-radius: 6px;
            color: var(--accent-amber);
            font-size: 0.85rem;
        }

        .rec-panel-btns {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .rec-btn-pill {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 5px 12px;
            border-radius: 16px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .rec-btn-pill:hover {
            background: rgba(255, 255, 255, 0.18);
        }

        .btn-play-user {
            color: var(--accent-green);
            border-color: rgba(52, 211, 153, 0.3);
        }

        .btn-play-user:hover {
            background: rgba(52, 211, 153, 0.2);
        }

        .btn-compare {
            color: var(--accent-blue);
            border-color: rgba(56, 189, 248, 0.3);
        }

        .btn-compare:hover {
            background: rgba(56, 189, 248, 0.2);
        }

        .btn-rerecord {
            color: var(--accent-amber);
            border-color: rgba(251, 191, 36, 0.3);
        }

        .btn-del {
            color: var(--text-muted);
        }

        .btn-del:hover {
            color: var(--accent-red);
        }

        /* Card Body */
        .card-body {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .transcript-box {
            font-size: 1.15rem;
            color: #f1f5f9;
            background: rgba(0, 0, 0, 0.3);
            padding: 16px 20px;
            border-radius: 12px;
            border-left: 4px solid var(--accent-blue);
            font-style: normal;
            line-height: 1.8;
        }

        .ans-highlight {
            color: #34d399;
            font-weight: 700;
            font-style: normal;
            background: rgba(52, 211, 153, 0.15);
            padding: 2px 8px;
            border-radius: 5px;
            border-bottom: 2px solid rgba(52, 211, 153, 0.5);
        }

        .trap-highlight {
            color: #f87171;
            font-weight: 700;
            font-style: normal;
            text-decoration: line-through;
            background: rgba(248, 113, 113, 0.15);
            padding: 2px 8px;
            border-radius: 5px;
        }

        .signal-highlight {
            color: #fbbf24;
            font-weight: 700;
            font-style: normal;
            padding: 1px 4px;
        }

        .analysis-box {
            font-size: 1.02rem;
            color: #cbd5e1;
            line-height: 1.65;
            padding: 12px 18px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 10px;
        }

        .analysis-box strong {
            color: var(--text-main);
        }

        /* Bilingual Details Section */
        .bilingual-details {
            margin-top: 10px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            overflow: hidden;
            background: rgba(0, 0, 0, 0.35);
        }

        .bilingual-summary {
            padding: 12px 18px;
            background: rgba(255, 255, 255, 0.05);
            cursor: pointer;
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--accent-blue);
            display: flex;
            justify-content: space-between;
            align-items: center;
            user-select: none;
            transition: background 0.2s;
        }

        .bilingual-summary:hover {
            background: rgba(255, 255, 255, 0.09);
        }

        .summary-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .toggle-badge {
            font-size: 0.82rem;
            color: var(--text-muted);
            font-weight: normal;
            background: rgba(255, 255, 255, 0.08);
            padding: 3px 10px;
            border-radius: 12px;
        }

        .toggle-icon {
            font-size: 0.9rem;
            transition: transform 0.2s;
        }

        details[open] .toggle-icon {
            transform: rotate(180deg);
        }

        .bilingual-body {
            padding: 18px 22px;
            font-size: 1.12rem;
            line-height: 1.8;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .dialog-turn {
            padding-bottom: 12px;
            border-bottom: 1px dashed rgba(255, 255, 255, 0.09);
        }

        .dialog-turn:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .speaker-tag {
            font-weight: 700;
            font-size: 0.92rem;
            padding: 3px 10px;
            border-radius: 5px;
            display: inline-block;
            margin-right: 8px;
        }

        .spk-man { background: rgba(56, 189, 248, 0.2); color: var(--accent-blue); }
        .spk-woman { background: rgba(192, 132, 252, 0.2); color: var(--accent-purple); }
        .spk-speaker { background: rgba(52, 211, 153, 0.2); color: var(--accent-green); }
        .spk-tutor { background: rgba(251, 191, 36, 0.2); color: var(--accent-amber); }
        .spk-philip { background: rgba(56, 189, 248, 0.2); color: var(--accent-blue); }
        .spk-janice { background: rgba(248, 113, 113, 0.2); color: var(--accent-red); }

        .en-line {
            color: #f8fafc;
            font-size: 1.12rem;
            font-weight: 500;
            line-height: 1.8;
            margin-bottom: 6px;
        }

        .cn-line {
            color: #cbd5e1;
            font-size: 1.02rem;
            line-height: 1.65;
        }

        /* Tips section */
        .tips-panel {
            background: linear-gradient(135deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.7));
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px 24px;
            margin-bottom: 30px;
        }

        .tips-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--accent-amber);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tips-list {
            padding-left: 20px;
            color: var(--text-muted);
            font-size: 0.9rem;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .tips-list strong {
            color: var(--text-main);
        }

        .shadow-guide-box {
            background: rgba(248, 113, 113, 0.1);
            border: 1px solid rgba(248, 113, 113, 0.3);
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 25px;
            font-size: 0.9rem;
            color: #fca5a5;
            line-height: 1.5;
        }

        .shadow-guide-title {
            font-weight: 700;
            color: #f87171;
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .shadow-guide-tag {
            font-size: 0.75rem;
            background: rgba(248, 113, 113, 0.2);
            padding: 2px 8px;
            border-radius: 10px;
            color: #fecaca;
        }
    </style>
