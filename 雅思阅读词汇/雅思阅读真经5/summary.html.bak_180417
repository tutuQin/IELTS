    <!-- ================= 替换对沉淀 ================= -->
    <div class="card">
      <div class="card-header">
        <div class="q-title">🔁 本篇改写对沉淀（20 组，可直接进改写本）</div>
        <div class="q-ans-pill">20 pairs</div>
      </div>
      <table style="width:100%; border-collapse:collapse; font-size:13.5px; margin-top:6px;">
        <thead>
          <tr style="background:#162032; color:var(--para-color);">
            <th style="padding:8px 10px; text-align:left; border:1px solid var(--card-border);">#</th>
            <th style="padding:8px 10px; text-align:left; border:1px solid var(--card-border);">题干（考官）</th>
            <th style="padding:8px 10px; text-align:left; border:1px solid var(--card-border);">原文（录音/文章）</th>
            <th style="padding:8px 10px; text-align:left; border:1px solid var(--card-border);">改写类型</th>
            <th style="padding:8px 10px; text-align:left; border:1px solid var(--card-border);">中文对照</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">1</td><td style="padding:6px 10px; border:1px solid var(--card-border);">geneticists</td><td style="padding:6px 10px; border:1px solid var(--card-border);">scientists</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">上位词 → 具体分支</td><td style="padding:6px 10px; border:1px solid var(--card-border);">科学家 ⇄ 遗传学家</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">2</td><td style="padding:6px 10px; border:1px solid var(--card-border);">assert</td><td style="padding:6px 10px; border:1px solid var(--card-border);">believe</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">同义动词（语气升级）</td><td style="padding:6px 10px; border:1px solid var(--card-border);">断言 ⇄ 认为</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">3</td><td style="padding:6px 10px; border:1px solid var(--card-border);">recreate</td><td style="padding:6px 10px; border:1px solid var(--card-border);">reproduce</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">同义动词</td><td style="padding:6px 10px; border:1px solid var(--card-border);">重新创造 ⇄ 复制/繁殖</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">4</td><td style="padding:6px 10px; border:1px solid var(--card-border);">bone specimen</td><td style="padding:6px 10px; border:1px solid var(--card-border);">bones / specimen conserved in ethanol</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">句子压缩成短语</td><td style="padding:6px 10px; border:1px solid var(--card-border);">骨骼标本 ⇄ 泡在乙醇里的标本 / 从骨骼提 DNA</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">5</td><td style="padding:6px 10px; border:1px solid var(--card-border);">have a ___ in common</td><td style="padding:6px 10px; border:1px solid var(--card-border);">unlike other marsupials, the pouch ...</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">差异 → 共性（反推）</td><td style="padding:6px 10px; border:1px solid var(--card-border);">共同拥有 ⇄ 与其它有袋类不同（就在于袋口）</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">6</td><td style="padding:6px 10px; border:1px solid var(--card-border);">primarily</td><td style="padding:6px 10px; border:1px solid var(--card-border);">mainly</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">同义副词</td><td style="padding:6px 10px; border:1px solid var(--card-border);">首要地 ⇄ 主要地</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">7</td><td style="padding:6px 10px; border:1px solid var(--card-border);">depended on</td><td style="padding:6px 10px; border:1px solid var(--card-border);">relied on</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">同义动词短语</td><td style="padding:6px 10px; border:1px solid var(--card-border);">依靠 ⇄ 依赖</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">8</td><td style="padding:6px 10px; border:1px solid var(--card-border);">when chasing their preys</td><td style="padding:6px 10px; border:1px solid var(--card-border);">in the chase</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">名词 → 时间从句</td><td style="padding:6px 10px; border:1px solid var(--card-border);">追逐猎物时 ⇄ 在追捕中</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">9</td><td style="padding:6px 10px; border:1px solid var(--card-border);">inflate</td><td style="padding:6px 10px; border:1px solid var(--card-border);">distend</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">同义动词（医学化）</td><td style="padding:6px 10px; border:1px solid var(--card-border);">膨胀 ⇄ 撑开/扩张</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">10</td><td style="padding:6px 10px; border:1px solid var(--card-border);">a period lack of food</td><td style="padding:6px 10px; border:1px solid var(--card-border);">longer period without eating / food scarcity</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">两状语合并为名词短语</td><td style="padding:6px 10px; border:1px solid var(--card-border);">一段缺食期 ⇄ 长时间不进食 + 食物匮乏</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">11</td><td style="padding:6px 10px; border:1px solid var(--card-border);">to compensate for</td><td style="padding:6px 10px; border:1px solid var(--card-border);">for compensating</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">for + doing ⇄ to do<br><span style="color:#f87171;">（词形改变，属本题瑕疵，不可模仿）</span></td><td style="padding:6px 10px; border:1px solid var(--card-border);">为了补偿 ⇄ 用于补偿</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">12</td><td style="padding:6px 10px; border:1px solid var(--card-border);">diet</td><td style="padding:6px 10px; border:1px solid var(--card-border);">food list</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">抽象 ⇄ 具体清单</td><td style="padding:6px 10px; border:1px solid var(--card-border);">食谱 ⇄ 食物清单</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">13</td><td style="padding:6px 10px; border:1px solid var(--card-border);">resulted in</td><td style="padding:6px 10px; border:1px solid var(--card-border);">led to</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">同义因果短语</td><td style="padding:6px 10px; border:1px solid var(--card-border);">导致 ⇄ 导致</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">14</td><td style="padding:6px 10px; border:1px solid var(--card-border);">seldom</td><td style="padding:6px 10px; border:1px solid var(--card-border);">hardly</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">否定副词互换</td><td style="padding:6px 10px; border:1px solid var(--card-border);">很少 ⇄ 几乎不</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">15</td><td style="padding:6px 10px; border:1px solid var(--card-border);">set up ... resistance</td><td style="padding:6px 10px; border:1px solid var(--card-border);">put up ... resistance</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">搭配动词替换</td><td style="padding:6px 10px; border:1px solid var(--card-border);">进行抵抗 ⇄ 进行抵抗</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">16</td><td style="padding:6px 10px; border:1px solid var(--card-border);">in front of the foes</td><td style="padding:6px 10px; border:1px solid var(--card-border);">before their enemies</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">介词短语 + 同义名词</td><td style="padding:6px 10px; border:1px solid var(--card-border);">在敌人面前 ⇄ 在敌人面前</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">17</td><td style="padding:6px 10px; border:1px solid var(--card-border);">rival for</td><td style="padding:6px 10px; border:1px solid var(--card-border);">competed for</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">动词 → 名词</td><td style="padding:6px 10px; border:1px solid var(--card-border);">竞争者 ⇄ 争夺</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">18</td><td style="padding:6px 10px; border:1px solid var(--card-border);">habitats and food sources</td><td style="padding:6px 10px; border:1px solid var(--card-border);">food and shelter</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">上位词替换</td><td style="padding:6px 10px; border:1px solid var(--card-border);">栖息地与食物来源 ⇄ 食物与栖身之处</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">19</td><td style="padding:6px 10px; border:1px solid var(--card-border);">destroyed</td><td style="padding:6px 10px; border:1px solid var(--card-border);">were cleared</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">被动 → 主动 + 语义加重</td><td style="padding:6px 10px; border:1px solid var(--card-border);">摧毁 ⇄ 被清除</td></tr>
          <tr><td style="padding:6px 10px; border:1px solid var(--card-border);">20</td><td style="padding:6px 10px; border:1px solid var(--card-border);">proven / perished / marked the termination</td><td style="padding:6px 10px; border:1px solid var(--card-border);">confirmed / died / making an end to</td><td style="padding:6px 10px; border:1px solid var(--card-border); color:var(--text-muted);">书面语升格</td><td style="padding:6px 10px; border:1px solid var(--card-border);">被证实/死亡/标志终结 ⇄ 被确认/死去/终结</td></tr>
