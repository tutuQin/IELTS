          <tr><td style="padding:7px 10px; border:1px solid var(--card-border);">Q9</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--ans-color); font-weight:700;">European settlers</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--trap-color); text-decoration:line-through;">european</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--trap-color);">✗</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--text-muted);">被动句还原主动，补出施动者</td></tr>
          <tr><td style="padding:7px 10px; border:1px solid var(--card-border);">Q10</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--ans-color); font-weight:700;">1936</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--trap-color); text-decoration:line-through;">tree / three years later</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--trap-color);">✗</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--text-muted);">in + 年份；perished = died</td></tr>
          <tr><td style="padding:7px 10px; border:1px solid var(--card-border);">Q11</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--ans-color); font-weight:700;">sightings</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--trap-color); text-decoration:line-through;">media</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--trap-color);">✗</td><td style="padding:7px 10px; border:1px solid var(--card-border); color:var(--text-muted);">but + none + confirmed 整句对应</td></tr>
